# Copy to .env before: docker compose up -d
# Never commit the real .env file.
METADATA_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/dbops
METADATA_DB_USERNAME=dbops
METADATA_DB_PASSWORD=change-me-app

ORACLE_JDBC_URL=jdbc:oracle:thin:@//127.0.0.1:1523/dbops
ORACLE_DB_USERNAME=dbops
ORACLE_DB_PASSWORD=change-me-app

# Local development only: Vault dev mode is in-memory and this token is root-equivalent.
# Replace it in your untracked .env file. Never use dev mode or this token outside local development.
VAULT_TOKEN=local-vault-root-token
VAULT_ADDRESS=http://127.0.0.1:8200
VAULT_SECRET_PATH=projects/{PROJECT_CODE}/environments/{ENVIRONMENT}/data-sources/{DATA_SOURCE}

# Load Credential[username, password] from vault base on PROJECT_CODE, ENVIRONMENT, DATASOURCE
SECRET_REF=vault_secret_path
